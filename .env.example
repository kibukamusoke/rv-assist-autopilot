# Local mode is credential-free.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
STATE_STORE=memory
EVENT_BUS=memory
WORKFLOW_SCHEDULER=memory
NICHEWAVE_ADAPTER=mock
QUALIFIER_MODE=deterministic

# Gemini via Google AI Studio (local development).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=8000

# Or Gemini via Vertex AI / Google Cloud ADC.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Production adapter resources.
FIRESTORE_DATABASE_ID=(default)
PUBSUB_WORKFLOW_TOPIC=rv-assist-workflow-events
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=us-west4
CLOUD_TASKS_QUEUE=rv-assist-response-deadlines
CLOUD_TASKS_TARGET_URL=https://placeholder.invalid/v1/events/tasks
NICHEWAVE_BASE_URL=
NICHEWAVE_API_TOKEN=

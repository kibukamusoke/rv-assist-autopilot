{
  "name": "rv-assist-autopilot",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Durable, auditable AI orchestration for RV repair requests.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo": "tsx samples/run-demo.ts",
    "demo:workflow": "tsx samples/run-workflow-demo.ts",
    "adk:run": "adk run src/agents/agent.ts",
    "adk:web": "adk web",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run-evals.ts",
    "eval:adversarial": "tsx evals/run-adversarial-evals.ts",
    "eval:autonomy": "tsx evals/run-autonomy-evals.ts",
    "eval:adk:live": "tsx evals/run-adk-live-evals.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run eval && npm run eval:autonomy && npm run eval:adversarial",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.0",
    "@google-cloud/pubsub": "^6.0.1",
    "@google-cloud/tasks": "^7.0.0",
    "@google/adk": "^1.6.0",
    "@google/genai": "^2.17.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "pino": "^10.3.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@google/adk-devtools": "^1.6.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
